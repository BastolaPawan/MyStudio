@model MyStudio.Models.Customer

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>
<hr />
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Add New Customer</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Customers Basic Information -->
                        <div class="form-group mb-3">
                            <label asp-for="Name" class="form-label">Customer Name *</label>
                            <input asp-for="Name" class="form-control" placeholder="e.g., Balen Shah" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="CustomerType" class="form-label">Customer Type *</label>
                            <select asp-for="CustomerType"
                                    class="form-select"
                                    id="customerTypeSelect">
                                <option value="Retail">Retail</option>
                                <option value="Wholesale">Wholesale</option>
                            </select>
                            <span asp-validation-for="CustomerType" class="text-danger"></span>
                        </div>

                        <div id="wholesaleFields" style="display: none;">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label asp-for="BusinessName" class="form-label">Business Name</label>
                                        <input asp-for="BusinessName" class="form-control" placeholder="e.g., Ma Sarada Photo Studio" />
                                        <span asp-validation-for="BusinessName" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label asp-for="TaxNumber" class="form-label">Tax Number</label>
                                        <input asp-for="TaxNumber" class="form-control" placeholder="e.g., 302154845" />
                                        <span asp-validation-for="TaxNumber" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Phone" class="form-label">Phone</label>
                                    <input asp-for="Phone" class="form-control" placeholder="e.g., 986XXXXXXX" />
                                    <span asp-validation-for="Phone" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Email" class="form-label">Email</label>
                                    <input asp-for="Email" class="form-control" placeholder="e.g., balenshah@gmail.com" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Address & Terms -->
                        <div class="form-group mb-3">
                            <label asp-for="Address" class="form-label">Address</label>
                            <textarea asp-for="Address" class="form-control" rows="3" placeholder="Full address..."></textarea>
                        </div>
                        @* 
                            <div class="form-group mb-4">
                                <label asp-for="BusinessName" class="form-label">BusinessName</label>
                                <input asp-for="BusinessName" class="form-control" placeholder="e.g., Ma sarada photo studio" />
                                <span asp-validation-for="BusinessName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="TaxNumber" class="form-label">Tax Number</label>
                                    <input asp-for="TaxNumber" class="form-control" placeholder="e.g., 302154845" />
                                    <span asp-validation-for="TaxNumber" class="text-danger"></span>
                                </div>
                            </div> *@

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="DiscountPercentage" class="form-label">Discount Percentage</label>
                                <input asp-for="DiscountPercentage" class="form-control" placeholder="e.g., 7" />
                                <span asp-validation-for="DiscountPercentage" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" checked asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
                                </label>
                            </div>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-success">Create</button>
                            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>




@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const customerTypeSelect = document.getElementById('customerTypeSelect');
            const wholesaleFields = document.getElementById('wholesaleFields');

                   function toggleWholesaleFields() {
            if (customerTypeSelect.value === 'Wholesale') {
                wholesaleFields.style.display = 'block';
            } else {
                wholesaleFields.style.display = 'none';
            }
        }

            // Run on page load
            toggleWholesaleFields();

            // Run when user changes selection
            customerTypeSelect.addEventListener('change', toggleWholesaleFields);
        });
    </script>
}
