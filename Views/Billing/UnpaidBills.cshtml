@model IEnumerable<MyStudio.Models.Order>
@{
    ViewData["Title"] = "Unpaid Bills";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Unpaid Bills</h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Orders
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Unpaid Orders (@Model.Count() orders)</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Date</th>
                                <th>Customer</th>
                                <th>Customer Type</th>
                                <th>Total Amount</th>
                                <th>Balance Due</th>
                                <th>Days Overdue</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                var daysOverdue = (DateTime.Now - order.OrderDate).Days;
                                <tr>
                                    <td>
                                        <strong>@order.OrderNumber</strong>
                                    </td>
                                    <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td>@order.Customer?.Name</td>
                                    <td>
                                        <span class="badge bg-@(order.Customer?.CustomerType == "Wholesale" ? "info" : "secondary")">
                                            @order.Customer?.CustomerType
                                        </span>
                                    </td>
                                    <td>@order.TotalAmount.ToString("C")</td>
                                    <td class="text-danger fw-bold">@order.BalanceAmount.ToString("C")</td>
                                    <td>
                                        <span class="badge bg-@(daysOverdue > 30 ? "danger" : daysOverdue > 15 ? "warning" : "info")">
                                            @daysOverdue days
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-@GetStatusBadgeColor(order.Status)">@order.Status</span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-info" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="AddPayment" asp-route-id="@order.Id" class="btn btn-success" title="Add Payment">
                                                <i class="fas fa-money-bill-wave"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-primary">
                                <td colspan="5" class="text-end"><strong>Total Outstanding:</strong></td>
                                <td colspan="4"><strong>@Model.Sum(o => o.BalanceAmount).ToString("C")</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i> Great news! There are no unpaid bills.
        </div>
    }
</div>

@functions {
    public string GetStatusBadgeColor(string status)
    {
        return status switch
        {
            "Draft" => "secondary",
            "Confirmed" => "primary",
            "InProgress" => "info",
            "Ready" => "warning",
            "Delivered" => "success",
            "Cancelled" => "danger",
            _ => "secondary"
        };
    }
}