@model MyStudio.Models.OrderSearchViewModel
@{
    ViewData["Title"] = "Order Management";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Order Management</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Create New Order
        </a>
    </div>

    <!-- Search Form -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="card-title mb-0">Search Orders</h5>
        </div>
        <div class="card-body">
            <form asp-action="Search" method="post">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="OrderNumber" class="form-label">Order Number</label>
                            <input asp-for="OrderNumber" class="form-control" placeholder="ORD-2024-001" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="CustomerName" class="form-label">Customer Name</label>
                            <input asp-for="CustomerName" class="form-control" placeholder="Customer name" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label asp-for="Status" class="form-label">Status</label>
                            <select asp-for="Status" class="form-control">
                                <option value="">All</option>
                                <option value="Draft">Draft</option>
                                <option value="Confirmed">Confirmed</option>
                                <option value="InProgress">In Progress</option>
                                <option value="Ready">Ready</option>
                                <option value="Delivered">Delivered</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label asp-for="PaymentStatus" class="form-label">Payment Status</label>
                            <select asp-for="PaymentStatus" class="form-control">
                                <option value="">All</option>
                                <option value="Pending">Pending</option>
                                <option value="Partial">Partial</option>
                                <option value="Paid">Paid</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row mt-2">
                    <div class="col-md-2">
                        <div class="form-group">
                            <label asp-for="FromDate" class="form-label">From Date</label>
                            <input asp-for="FromDate" type="date" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label asp-for="ToDate" class="form-label">To Date</label>
                            <input asp-for="ToDate" type="date" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="form-check mt-4">
                            <input asp-for="ShowUnpaidOnly" class="form-check-input" />
                            <label asp-for="ShowUnpaidOnly" class="form-check-label">Show Unpaid Orders Only</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="ShowCancelled" class="form-check-input" />
                            <label asp-for="ShowCancelled" class="form-check-label">Include Cancelled Orders</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="ShowBadDebts" class="form-check-input" />
                            <label asp-for="ShowBadDebts" class="form-check-label">Show Bad Debts</label>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search"></i> Search
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Results -->
    @if (Model.Results != null && Model.Results.Any())
    {
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Search Results (@Model.Results.Count orders found)</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Date</th>
                                <th>Customer</th>
                                <th>Type</th>
                                <th>Total Amount</th>
                                <th>Balance</th>
                                <th>Status</th>
                                <th>Payment</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Results)
                            {
                                <tr>
                                    <td>
                                        <strong>@order.OrderNumber</strong>
                                        @if (order.IsCancelled)
                                        {
                                            <span class="badge bg-danger">Cancelled</span>
                                        }
                                        @if (order.IsBadDebt)
                                        {
                                            <span class="badge bg-warning">Bad Debt</span>
                                        }
                                    </td>
                                    <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td>@order.Customer?.Name</td>
                                    <td>@order.OrderType</td>
                                    <td>@order.TotalAmount.ToString("C")</td>
                                    <td class="@(order.BalanceAmount > 0 ? "balance-positive" : "balance-zero")">
                                        @order.BalanceAmount.ToString("C")
                                    </td>
                                    <td>
                                        <span class="badge bg-@GetStatusBadgeColor(order.Status)">@order.Status</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-@GetPaymentStatusBadgeColor(order.PaymentStatus)">@order.PaymentStatus</span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-info" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if (!order.IsCancelled && order.PaymentStatus != "Paid")
                                            {
                                                <a asp-action="AddPayment" asp-route-id="@order.Id" class="btn btn-success" title="Add Payment">
                                                    <i class="fas fa-money-bill-wave"></i>
                                                </a>
                                            }
                                            @if (!order.IsCancelled && order.Status != "Delivered")
                                            {
                                                <button type="button" class="btn btn-warning update-status" data-order-id="@order.Id" data-status="Ready" title="Mark as Ready">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (Model.Results != null)
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No orders found matching your criteria.
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.update-status').click(function () {
                var orderId = $(this).data('order-id');
                var status = $(this).data('status');

                if (confirm('Are you sure you want to mark this order as ' + status + '?')) {
                    $.post('@Url.Action("MarkAsReady", "Billing")', { id: orderId })
                        .done(function (response) {
                            if (response.success) {
                                location.reload();
                            } else {
                                alert('Error: ' + response.message);
                            }
                        })
                        .fail(function () {
                            alert('Error updating order status');
                        });
                }
            });
        });
    </script>
}

@functions {
    public string GetStatusBadgeColor(string status)
    {
        return status switch
        {
            "Draft" => "secondary",
            "Confirmed" => "primary",
            "InProgress" => "info",
            "Ready" => "warning",
            "Delivered" => "success",
            "Cancelled" => "danger",
            _ => "secondary"
        };
    }

    public string GetPaymentStatusBadgeColor(string paymentStatus)
    {
        return paymentStatus switch
        {
            "Pending" => "warning",
            "Partial" => "info",
            "Paid" => "success",
            _ => "secondary"
        };
    }
}