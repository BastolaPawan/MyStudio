@model MyStudio.Models.CreateOrderViewModel
@{
    ViewData["Title"] = "Create New Order";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Create New Order</h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Orders
        </a>
    </div>

    <form asp-action="Create" method="post" id="orderForm">
        @Html.AntiForgeryToken()

        <div class="row">
            <!-- Customer & Order Info -->
            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Customer & Order Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-group mb-3">
                            <label asp-for="CustomerId" class="form-label">Customer *</label>
                            <select asp-for="CustomerId" asp-items="@(new SelectList(Model.Customers, "Id", "Name"))" class="form-control" required>
                                <option value="">-- Select Customer --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="OrderType" class="form-label">Order Type</label>
                                    <select asp-for="OrderType" class="form-control">
                                        <option value="Studio">Studio</option>
                                        <option value="Outdoor">Outdoor</option>
                                        <option value="Wedding">Wedding</option>
                                        <option value="Package">Package</option>
                                        <option value="Service">Service</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="SessionType" class="form-label">Session Type</label>
                                    <input asp-for="SessionType" class="form-control" placeholder="e.g., Portrait, Family, Commercial" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="PhotoShootDate" class="form-label">Photo Shoot Date</label>
                                    <input asp-for="PhotoShootDate" type="datetime-local" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="DeliveryDate" class="form-label">Expected Delivery Date</label>
                                    <input asp-for="DeliveryDate" type="datetime-local" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="DeliveryMethod" class="form-label">Delivery Method</label>
                            <select asp-for="DeliveryMethod" class="form-control">
                                <option value="Pickup">Customer Pickup</option>
                                <option value="Courier">Courier Delivery</option>
                                <option value="HomeDelivery">Home Delivery</option>
                            </select>
                        </div>

                        <div id="courierSection" style="display: none;">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label asp-for="CourierName" class="form-label">Courier Name</label>
                                        <input asp-for="CourierName" class="form-control" placeholder="e.g., DHL, FedEx" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label asp-for="DeliveryAddress" class="form-label">Delivery Address</label>
                                        <textarea asp-for="DeliveryAddress" class="form-control" rows="2"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Advance Payment -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Advance Payment</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="AdvanceAmount" class="form-label">Advance Amount</label>
                                    <input asp-for="AdvanceAmount" type="number" step="0.01" class="form-control" value="0" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="AdvancePaymentMethod" class="form-label">Payment Method</label>
                                    <select asp-for="AdvancePaymentMethod" class="form-control">
                                        <option value="Cash">Cash</option>
                                        <option value="Card">Card</option>
                                        <option value="BankTransfer">Bank Transfer</option>
                                        <option value="Online">Online Payment</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Items -->
            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">Order Items</h5>
                        <button type="button" class="btn btn-sm btn-primary" id="addItem">
                            <i class="fas fa-plus"></i> Add Item
                        </button>
                    </div>
                    <div class="card-body">
                        <div id="orderItems">
                            <!-- Items will be added dynamically -->
                        </div>
                        <div class="text-end mt-3">
                            <h5>Subtotal: <span id="subtotal">$0.00</span></h5>
                            <h5>Tax (13%): <span id="taxAmount">$0.00</span></h5>
                            <h4>Total: <span id="totalAmount">$0.00</span></h4>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Additional Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-group mb-3">
                            <label asp-for="Notes" class="form-label">Notes</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Any special instructions or notes..."></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <button type="submit" class="btn btn-success btn-lg">
                <i class="fas fa-save"></i> Create Order
            </button>
            <a asp-action="Index" class="btn btn-secondary btn-lg">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Item template
        const itemTemplate = (index) => `
            <div class="order-item border p-3 mb-3" data-index="${index}">
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Item Type</label>
                            <select name="Items[${index}].ItemType" class="form-control item-type" onchange="updateItemFields(${index})">
                                <option value="Service">Service</option>
                                <option value="Product">Product</option>
                                <option value="Custom">Custom</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="form-group">
                            <label class="form-label">Description *</label>
                            <select name="Items[${index}].ProductId" class="form-control product-select" style="display: none;">
                                <option value="">-- Select Product/Service --</option>
                                @foreach (var ps in Model.ProductsServices)
                                {
                                        <option value="@ps.Id" data-price="@ps.Price" data-type="@ps.Type">@ps.Name - $@ps.Price</option>
                                }
                            </select>
                            <input type="text" name="Items[${index}].Description" class="form-control custom-desc" placeholder="Item description" required style="display: none;" />
                        </div>
                    </div>
                    <div class="col-md-1">
                        <div class="form-group">
                            <label class="form-label">Qty</label>
                            <input type="number" name="Items[${index}].Quantity" class="form-control quantity" value="1" min="1" onchange="calculateLineTotal(${index})" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="form-label">Price</label>
                            <input type="number" step="0.01" name="Items[${index}].UnitPrice" class="form-control unit-price" value="0" onchange="calculateLineTotal(${index})" />
                        </div>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="form-label">Discount %</label>
                            <input type="number" step="0.01" name="Items[${index}].DiscountPercent" class="form-control discount" value="0" onchange="calculateLineTotal(${index})" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="form-label">Line Total</label>
                            <input type="text" class="form-control line-total" readonly value="$0.00" />
                        </div>
                    </div>
                    <div class="col-md-6 text-end">
                        <button type="button" class="btn btn-danger btn-sm mt-3" onclick="removeItem(${index})">
                            <i class="fas fa-trash"></i> Remove
                        </button>
                    </div>
                </div>
            </div>
        `;

        let itemCount = 0;

        $(document).ready(function () {
            // Add first item
            addItem();

            // Toggle courier section
            $('#DeliveryMethod').change(function () {
                if ($(this).val() === 'Courier') {
                    $('#courierSection').show();
                } else {
                    $('#courierSection').hide();
                }
            });

            // Add item button
            $('#addItem').click(function () {
                addItem();
            });
        });

        function addItem() {
            $('#orderItems').append(itemTemplate(itemCount));
            itemCount++;
            updateTotals();
        }

        function removeItem(index) {
            $(`.order-item[data-index="${index}"]`).remove();
            updateTotals();
        }

        function updateItemFields(index) {
            const type = $(`.order-item[data-index="${index}"] .item-type`).val();
            const productSelect = $(`.order-item[data-index="${index}"] .product-select`);
            const customDesc = $(`.order-item[data-index="${index}"] .custom-desc`);

            if (type === 'Custom') {
                productSelect.hide();
                customDesc.show().val('').focus();
            } else {
                productSelect.show();
                customDesc.hide();
                if (type === 'Service') {
                    productSelect.find('option').show();
                } else {
                    productSelect.find('option').each(function() {
                        $(this).toggle($(this).data('type') === 'Product');
                    });
                }
            }
        }

        function calculateLineTotal(index) {
            const quantity = parseFloat($(`.order-item[data-index="${index}"] .quantity`).val()) || 0;
            const unitPrice = parseFloat($(`.order-item[data-index="${index}"] .unit-price`).val()) || 0;
            const discount = parseFloat($(`.order-item[data-index="${index}"] .discount`).val()) || 0;

            const lineTotal = quantity * unitPrice * (1 - discount / 100);
            $(`.order-item[data-index="${index}"] .line-total`).val('$' + lineTotal.toFixed(2));

            updateTotals();
        }

        function updateTotals() {
            let subtotal = 0;
            $('.order-item').each(function() {
                const lineTotalText = $(this).find('.line-total').val();
                const lineTotal = parseFloat(lineTotalText.replace('$', '')) || 0;
                subtotal += lineTotal;
            });

            const tax = subtotal * 0.13;
            const total = subtotal + tax;

            $('#subtotal').text('$' + subtotal.toFixed(2));
            $('#taxAmount').text('$' + tax.toFixed(2));
            $('#totalAmount').text('$' + total.toFixed(2));
        }

        // Update price when product is selected
        $(document).on('change', '.product-select', function() {
            const selectedOption = $(this).find('option:selected');
            const price = selectedOption.data('price') || 0;
            const index = $(this).closest('.order-item').data('index');

            $(`.order-item[data-index="${index}"] .unit-price`).val(price);
            calculateLineTotal(index);
        });

        // Auto-calculate when any input changes
        $(document).on('input', '.quantity, .unit-price, .discount', function() {
            const index = $(this).closest('.order-item').data('index');
            calculateLineTotal(index);
        });
    </script>
}