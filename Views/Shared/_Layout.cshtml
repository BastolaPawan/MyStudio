<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Studio Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" asp-append-version="true" />

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Studio Management System</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Loans" asp-action="Index">Loans</a>
                        </li>
                        <!-- Add these inventory links -->
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Inventory" asp-action="Index">Inventory</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Inventory" asp-action="Vendors">Vendors</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Purchase" asp-action="Index">Purchases</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Customers" asp-action="Index">Customers</a>
                        </li>

                        <!-- Billing Section -->
                        <li class="nav-item dropdown">
                            <a class="nav-link text-light dropdown-toggle" href="#" id="billingDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-file-invoice-dollar"></i> Billing
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="billingDropdown">
                                <li>
                                    <a class="dropdown-item" asp-controller="Billing" asp-action="Index">
                                        <i class="fas fa-list"></i> All Orders
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Billing" asp-action="Create">
                                        <i class="fas fa-plus"></i> Create Order
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Billing" asp-action="UnpaidBills">
                                        <i class="fas fa-exclamation-triangle"></i> Unpaid Bills
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Billing" asp-action="BadDebts">
                                        <i class="fas fa-times-circle"></i> Bad Debts
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - Studio Management System
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/font-awesome/js/all.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>